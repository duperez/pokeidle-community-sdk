{
  "name": "pokeidle-community-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial community SDK for building PokeIdle extensions. Not affiliated with or endorsed by PokeIdle.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
